+    return {
+        "schema_version": "FIRST_RUN_EVIDENCE_ENVELOPE_V1",
+        "records": records,
+        "report_sha256": _canonical_sha256(report),
+        "identity_snapshot": {
+            "schema_version": "FIRST_TEST_IDENTITY_SNAPSHOT_V1",
+            "artifacts": artifacts,
+        },
+        "raw_outputs": {
+            name: {"content": raw, "sha256": _sha256(raw), "size_bytes": len(raw)}
